# Used for scoring, triage, metadata and drafts (cheap models by default).
# chrome-fetch.js keeps it out of the headless browser sessions: Claude in Chrome
# only works on a claude.ai login, not on an API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
# SCORING_MODEL=claude-haiku-4-5
# METADATA_MODEL=claude-haiku-4-5
# TRIAGE_MODEL=claude-haiku-4-5
# DRAFT_MODEL=claude-sonnet-5-5

# Recommended: keep everything personal in a separate private folder or repo.
# It holds profile/, active/, submitted/, archive/, state/ and output/.
# Unset, all of that lives inside this repo (gitignored).
# WORKSPACE_DIR=../my-applications

# Optional: a profile folder somewhere else again
# (default: <workspace>/profile/, then examples/profile/)
# PROFILE_DIR=../my-applications/profile

# Optional: where community-portals lives (default ../community-portals/portals)
# PORTALS_DIR=../community-portals/portals
